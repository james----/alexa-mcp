{
  "name": "alexa-mcp-server",
  "version": "1.2.0",
  "description": "MCP (Model Context Protocol) server that lets Claude and other LLMs control Amazon Alexa devices via a native TypeScript client.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "alexa-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "npm run build && tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "serve": "node dist/server.js",
    "serve:dev": "tsx src/server.ts",
    "auth": "tsx src/auth.ts",
    "service:install": "bash scripts/service.sh install",
    "service:start": "bash scripts/service.sh start",
    "service:stop": "bash scripts/service.sh stop",
    "service:restart": "bash scripts/service.sh restart",
    "service:status": "bash scripts/service.sh status",
    "service:logs": "bash scripts/service.sh logs",
    "service:shortcuts": "bash scripts/service.sh install-shortcuts",
    "service:shortcuts:remove": "bash scripts/service.sh uninstall-shortcuts",
    "service:uninstall": "bash scripts/service.sh uninstall",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alexa",
    "amazon-echo",
    "smart-home",
    "claude",
    "anthropic",
    "alexa-remote",
    "voice-assistant"
  ],
  "author": "James Tucker",
  "license": "MIT",
  "homepage": "https://github.com/james----/alexa-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/james----/alexa-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/james----/alexa-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "alexa-cookie2": "^5.0.4",
    "express": "^5.2.1",
    "extend": "^3.0.2",
    "http-proxy-middleware": "^2.0.6",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/extend": "^3.0.4",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.5.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
